# ======================================
# EnglishPro - Configuración de Desarrollo
# ======================================
# IMPORTANTE: Copiar este archivo como .env antes de iniciar
# Comando: cp .env.example .env
#
# Para desarrollo local, puedes usar estos valores por defecto
# Para producción, DEBES cambiar todos los secretos
# ======================================

# ===== DATABASE CONFIGURATION =====
# PostgreSQL - Usado por Docker Compose
DB_PASSWORD=admin123
DB_NAME=englishpro_db
DB_USER=admin
DB_HOST=localhost
DB_PORT=5432

# ===== JWT SECRET =====
# Para desarrollo puedes usar este valor
# IMPORTANTE: Cambiarlo en producción
JWT_SECRET=englishpro-dev-secret-key-2024-change-in-production

# ===== BACKEND CONFIGURATION =====
# URL del backend API
BACKEND_URL=http://localhost:8080

# ===== FIREBASE CONFIGURATION =====
# INSTRUCCIONES:
# 1. Crear proyecto en: https://console.firebase.google.com
# 2. Habilitar Authentication (Email/Password)
# 3. Habilitar Storage
# 4. Descargar google-services.json
# 5. Copiar google-services.json.example a google-services.json
# 6. Reemplazar los valores aquí con los de tu proyecto Firebase

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# ===== STRIPE CONFIGURATION =====
# Para desarrollo, puedes usar las test keys de Stripe
# Obtener en: https://dashboard.stripe.com/test/apikeys
# NOTA: En desarrollo, los pagos usan modo MOCK (no se procesan realmente)

STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# ===== CONFIGURACIÓN ADICIONAL =====
# Entorno de ejecución
NODE_ENV=development

# Puerto del backend (opcional, por defecto 8080)
PORT=8080
